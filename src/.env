# =====================================================================
# Inception — non-secret environment variables
# ---------------------------------------------------------------------
# !!! BEFORE BUILDING: replace every occurrence of "login" below with
# your real 42 username (LOGIN, DOMAIN_NAME, WP_ADMIN_USER, emails).
# Passwords do NOT live here: they live in ../../secrets/*.txt
# (Docker secrets) and are generated with `make secrets`.
# =====================================================================

# Your 42 login. Used for the domain name and the host data directory
# /home/<LOGIN>/data (see volumes in docker-compose.yml).
LOGIN=login

# Domain served by nginx (must resolve to your VM: `make domain`
# adds it to /etc/hosts).
DOMAIN_NAME=login.42.fr

# --- MariaDB ----------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# --- WordPress --------------------------------------------------------
# The administrator username MUST NOT contain "admin" (subject rule).
WP_ADMIN_USER=login
WP_ADMIN_EMAIL=login@student.42.fr
WP_TITLE=Inception
# Second, non-admin WordPress user (created automatically on first boot).
WP_USER=editor
WP_USER_EMAIL=editor@login.42.fr
WP_USER_ROLE=editor

# --- Redis (bonus: WordPress object cache) -----------------------------
REDIS_HOST=redis
