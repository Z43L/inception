# MariaDB server configuration (container-friendly).
[mysqld]
user              = mysql
bind-address      = 0.0.0.0
port              = 3306
datadir           = /var/lib/mysql
socket            = /run/mysqld/mysqld.sock
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
# Quiet, container-appropriate logging.
log_error         = /tmp/mariadb-error.log
