# /home/<LOGIN>/data (see volumes in docker-compose.yml).
LOGIN=

# Domain served by nginx (must resolve to your VM: `make domain`
# adds it to /etc/hosts).
DOMAIN_NAME=

# --- MariaDB ----------------------------------------------------------
MYSQL_DATABASE=
MYSQL_USER=

# --- WordPress --------------------------------------------------------
# The administrator username MUST NOT contain "admin" (subject rule).
WP_ADMIN_USER=
WP_ADMIN_EMAIL=example@student.42.fr
WP_TITLE=
# Second, non-admin WordPress user (created automatically on first boot).
WP_USER=
WP_USER_EMAIL=example@login.42.fr
WP_USER_ROLE=

